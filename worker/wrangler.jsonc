{
	"name": "carto-mh",
	"main": "index.ts",
	"compatibility_date": "2026-09-19",
	"vars": {
		"ADMIN_IDS": "112796",
		// Comma-separated exact origins allowed to call the relay.
		"ALLOWED_ORIGINS": "https://fluce.github.io,http://localhost:5173,https://carto-mh.alderoth.net,http://localhost:5174"
	},
	"routes": [
		{
			"pattern": "carto-mh.alderoth.net",
			"zone_name": "alderoth.net",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"assets": {
		"directory": "../dist",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"kv_namespaces": [
		{
			"binding": "USER_DATA",
			"id": "e3aeca1ad0d946fa91fc5614f423ca81"
		},
		{
			"binding": "GLOBAL_DATA",
			"id": "fe451fb0ebd74935a65f593f45ed0515"
		}
	],
	"triggers": {
		"crons": [
			"0 6 * * *"
		]
	},
	"workers_dev": true,
	"preview_urls": true,
	/*"r2_buckets": [
        {
            "binding": "DATA",
            "bucket_name": "carto-mh-data"
        }
    ]*/
}